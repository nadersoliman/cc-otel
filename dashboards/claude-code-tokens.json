{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Token Breakdown",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum(sum_over_time({service_name=~\"$service_name\"} | event_name = `api_request` | unwrap input_tokens | __error__=\"\" [$__range]))", "legendFormat": "Input", "refId": "A" },
        { "expr": "sum(sum_over_time({service_name=~\"$service_name\"} | event_name = `api_request` | unwrap output_tokens | __error__=\"\" [$__range]))", "legendFormat": "Output", "refId": "B" },
        { "expr": "sum(sum_over_time({service_name=~\"$service_name\"} | event_name = `api_request` | unwrap cache_read_tokens | __error__=\"\" [$__range]))", "legendFormat": "Cache Read", "refId": "C" },
        { "expr": "sum(sum_over_time({service_name=~\"$service_name\"} | event_name = `api_request` | unwrap cache_creation_tokens | __error__=\"\" [$__range]))", "legendFormat": "Cache Creation", "refId": "D" }
      ]
    },
    {
      "title": "Tokens by Model",
      "type": "piechart",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (model) (sum_over_time({service_name=~\"$service_name\"} | event_name = `api_request` | unwrap input_tokens | __error__=\"\" [$__range]))", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "title": "Input Tokens per Hour",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 80 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "barWidth": 0.8, "stacking": "normal", "xTickLabelRotation": -45 },
      "targets": [
        { "expr": "sum by (model) (sum_over_time({service_name=~\"$service_name\"} | event_name = `api_request` | unwrap input_tokens | __error__=\"\" [1h]))", "legendFormat": "{{model}}", "refId": "A" }
      ],
      "interval": "1h"
    },
