  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["claude-code", "otel", "tokens"],
  "templating": {
    "list": [
      {
        "name": "service_name",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service_name", "stream": "", "type": 1 },
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2
      }
    ]
