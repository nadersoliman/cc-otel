{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Events per Hour",
      "type": "barchart",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 80 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "barWidth": 0.8, "stacking": "normal", "xTickLabelRotation": -45 },
      "targets": [
        { "expr": "sum by (event_name) (count_over_time({service_name=~\"$service_name\"} | event_name =~ \"^($event_name)$\" | __error__=\"\" [1h]))", "legendFormat": "{{event_name}}", "refId": "A" }
      ],
      "interval": "1h"
    },
    {
      "title": "Event Breakdown",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "expr": "sum by (event_name) (count_over_time({service_name=~\"$service_name\"} | event_name =~ \"^($event_name)$\" | __error__=\"\" [$__range]))", "legendFormat": "{{event_name}}", "refId": "A" }
      ]
    },
    {
      "title": "Log Explorer",
      "type": "logs",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        { "expr": "{service_name=~\"$service_name\"} | event_name =~ \"^($event_name)$\" | line_format `[{{.event_name}}]{{if .model}} {{.model}}{{end}}{{if .tool_name}} {{.tool_name}}{{end}}{{if .cost_usd}} ${{.cost_usd}}{{end}}{{if .input_tokens}} in:{{.input_tokens}}{{end}}{{if .output_tokens}} out:{{.output_tokens}}{{end}}{{if .success}} ok:{{.success}}{{end}}{{if .decision}} {{.decision}}{{end}}{{if .error}} ERR: {{.error}}{{end}}{{if .prompt_length}} {{.prompt_length}}chars{{end}}{{if .duration_ms}} {{.duration_ms}}ms{{end}}`", "refId": "A", "maxLines": 500 }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["claude-code", "otel", "logs"],
  "templating": {
    "list": [
      {
        "name": "service_name",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service_name", "stream": "", "type": 1 },
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2
      },
      {
        "name": "event_name",
        "type": "custom",
        "label": "Event",
        "query": "api_request,tool_result,tool_decision,user_prompt,api_error",
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "multi": true
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Claude Code - Log Explorer",
  "uid": "claude-code-log-explorer",
  "version": 2
}
