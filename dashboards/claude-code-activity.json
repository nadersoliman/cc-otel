{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Active Sessions",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": { "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "count(claude_code_session_count_total{job=~\"$service_name\"})",
          "legendFormat": "active sessions",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Lines of Code per Hour",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "added" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "removed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "stacking": "normal",
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_lines_of_code_count_total{job=~\"$service_name\"}[1h]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Commits per Hour",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": { "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_commit_count_total{job=~\"$service_name\"}[1h]))",
          "legendFormat": "commits",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Pull Requests per Hour",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": { "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_pull_request_count_total{job=~\"$service_name\"}[1h]))",
          "legendFormat": "pull requests",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Active Time per Hour (minutes)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "color": { "mode": "fixed", "fixedColor": "super-light-blue" },
          "custom": { "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_active_time_seconds_total{job=~\"$service_name\"}[1h])) / 60",
          "legendFormat": "active time",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Code Edit Decisions per Hour",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "accept" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "reject" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "stacking": "normal",
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum by (decision) (increase(claude_code_code_edit_tool_decision_total{job=~\"$service_name\"}[1h]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Cost per Hour (USD)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "custom": { "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{job=~\"$service_name\"}[1h]))",
          "legendFormat": "cost",
          "refId": "A"
        }
      ],
      "interval": "1h"
    },
    {
      "title": "Tokens per Hour",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 80 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "input" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "output" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "cacheRead" },
            "properties": [{ "id": "color", "value": { "fixedColor": "light-blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "cacheCreation" },
            "properties": [{ "id": "color", "value": { "fixedColor": "light-purple", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" },
        "barWidth": 0.8,
        "stacking": "normal",
        "xTickLabelRotation": -45
      },
      "targets": [
        {
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total{job=~\"$service_name\"}[1h]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "interval": "1h"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["claude-code", "otel", "activity"],
  "templating": {
    "list": [
      {
        "name": "service_name",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(claude_code_session_count_total, job)",
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Claude Code \u2013 Activity",
  "uid": "claude-code-activity",
  "version": 4
}
